# Salin berkas ini menjadi .env lalu ganti seluruh nilai rahasia.
# Jangan pernah commit berkas .env.

APP_NAME=CMMS Sentinel
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=ganti-dengan-hasil-generate-acak-minimal-32-karakter
SESSION_COOKIE=cmms_sentinel_session
SESSION_MAX_AGE=28800
SESSION_HTTPS_ONLY=false

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cmms_ops

# Kunci untuk gateway IoT (header X-API-Key). Gunakan nilai acak panjang.
INGEST_API_KEY=ganti-dengan-api-key-gateway-acak

AUTO_SEED=true
# Simulator hanya untuk demo/pengembangan. Default nonaktif saat APP_ENV=production.
DEMO_TELEMETRY=true
SHOW_DEMO_CREDENTIALS=false

# Akun awal dibuat otomatis saat database kosong. Nilai di bawah hanya untuk demo.
SEED_ADMIN_EMAIL=admin@cmms.test
SEED_ADMIN_PASSWORD=Admin#2026!
SEED_TEKNISI_EMAIL=teknisi@cmms.test
SEED_TEKNISI_PASSWORD=Teknisi#2026!

APP_TIMEZONE=Asia/Jakarta
